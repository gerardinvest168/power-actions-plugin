  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.lock",
    "omarchy.clipboard"
  ],
  "cloneSourceRestores": [
    "io.github.omamenu",
    "zen.lock",
    "nguyenn.clipboard"
