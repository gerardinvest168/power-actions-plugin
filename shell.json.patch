        { "id": "omarchy.tray" },
        { "id": "jesseburlamaque.omarchy-find" },
        { "id": "omarchy.agents" },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" },
        { "id": "omarchy.audio" },
        { "id": "gerygerger.monitor" },
        { "id": "gerygerger.power", "showPercentage": true, "autoDimEnabled": true, "autoDimThreshold": 300, "autoDimTarget": 50 },
        { "id": "gerygerger.power-actions" }
      ]
